{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "rhel_small",
    "padding": {
      "top": 2,
      "left": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " ➜ "
  },
  "modules": [
    { "type": "custom", "format": "\u001b[1m───────  Usuario ──────────\u001b[0m" },
    { "type": "title", "key": "  " },
    { "type": "custom", "format": "\u001b[1m────── 󰒋 Software ──────────\u001b[0m" },
    { "type": "os", "key": "  " },
    { "type": "kernel", "key": "  " },
    { "type": "packages", "key": " 󰏖 " },
    { "type": "shell", "key": "  " },
    { "type": "terminal", "key": "  " },
    { "type": "custom", "format": "\u001b[1m────── 󰌢 Hardware ──────────\u001b[0m" },
    { "type": "cpu", "key": "  " },
    { "type": "gpu", "key": " 󰢮 " },
    { "type": "memory", "key": " 󰍛 " },
    { "type": "disk", "key": " 󰋊 " },
    { "type": "custom", "format": "\u001b[1m────────────────────────────\u001b[0m" }
  ]
}
